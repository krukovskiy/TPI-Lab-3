<UserControl x:Class="EdfBrowser.App.Views.Docks.AnnotationDockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Annotations" FontWeight="Bold"
                   Margin="4" FontSize="12"/>
        <TextBox DockPanel.Dock="Top" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4,0,4,4" ToolTip="Filter annotations..."/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="4">
            <TextBlock Text="{Binding AnnotationCount, StringFormat='Count: {0}'}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <ListView ItemsSource="{Binding Annotations}"
                  SelectedItem="{Binding SelectedAnnotation}"
                  MouseDoubleClick="OnAnnotationDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Onset" Width="90"
                                    DisplayMemberBinding="{Binding OnsetText}"/>
                    <GridViewColumn Header="Duration" Width="60"
                                    DisplayMemberBinding="{Binding DurationText}"/>
                    <GridViewColumn Header="Description" Width="120"
                                    DisplayMemberBinding="{Binding Description}"/>
                </GridView>
            </ListView.View>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Go to Annotation" Command="{Binding NavigateToAnnotationCommand}"/>
                    <MenuItem Header="Edit..." Command="{Binding EditAnnotationCommand}"/>
                    <Separator/>
                    <MenuItem Header="Delete" Command="{Binding DeleteAnnotationCommand}"/>
                    <Separator/>
                    <MenuItem Header="Export Annotations..." Command="{Binding ExportAnnotationsCommand}"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </DockPanel>
</UserControl>
