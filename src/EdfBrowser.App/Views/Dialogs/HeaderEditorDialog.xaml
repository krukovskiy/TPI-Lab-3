<Window x:Class="EdfBrowser.App.Views.Dialogs.HeaderEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EDF Header Editor" Width="700" Height="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Save" Command="{Binding SaveCommand}" Width="80" Margin="0,0,4,0"/>
            <Button Content="Close" Width="80" IsCancel="True"/>
        </StackPanel>

        <GroupBox Header="File Info" DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Format:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Format}" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>

                <TextBlock Text="Signals:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SignalCount}" Grid.Row="0" Grid.Column="3" VerticalAlignment="Center"/>

                <TextBlock Text="Patient ID:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Text="{Binding PatientId}" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4"/>

                <TextBlock Text="Recording ID:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Text="{Binding RecordingId}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,4"/>

                <TextBlock Text="Start Date/Time:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"/>
                <TextBlock Text="{Binding StartDateTime}" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="0,4"/>

                <TextBlock Text="Data Records:" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Margin="0,4"/>
                <TextBlock Text="{Binding DataRecordCount}" Grid.Row="3" Grid.Column="3" VerticalAlignment="Center" Margin="0,4"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Signal Parameters">
            <DataGrid ItemsSource="{Binding Signals}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="120"/>
                    <DataGridTextColumn Header="Dimension" Binding="{Binding PhysicalDimension}" Width="70"/>
                    <DataGridTextColumn Header="Phys Min" Binding="{Binding PhysicalMin}" Width="80"/>
                    <DataGridTextColumn Header="Phys Max" Binding="{Binding PhysicalMax}" Width="80"/>
                    <DataGridTextColumn Header="Dig Min" Binding="{Binding DigitalMin}" Width="70"/>
                    <DataGridTextColumn Header="Dig Max" Binding="{Binding DigitalMax}" Width="70"/>
                    <DataGridTextColumn Header="Samples/Rec" Binding="{Binding SamplesPerDataRecord}" Width="90"/>
                    <DataGridTextColumn Header="Transducer" Binding="{Binding TransducerType}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </DockPanel>
</Window>
