<Window x:Class="EdfBrowser.App.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About EDFbrowser" Width="350" Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="EDFbrowser for .NET" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <TextBlock Text="Version 1.0" FontSize="14" HorizontalAlignment="Center"
                   Foreground="Gray" Margin="0,0,0,16"/>
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16">
            A C#/WPF port of EDFbrowser by Teunis van Beelen.
            EDF/EDF+/BDF/BDF+ file viewer and signal analyzer.
        </TextBlock>
        <TextBlock Text="Licensed under GPL v3" HorizontalAlignment="Center"
                   Foreground="Gray" Margin="0,0,0,16"/>
        <Button Content="OK" Width="80" IsCancel="True" IsDefault="True"
                HorizontalAlignment="Center"/>
    </StackPanel>
</Window>
