<Window x:Class="EdfBrowser.App.Views.Dialogs.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Width="450" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Apply" Command="{Binding ApplyCommand}" Width="80" Margin="0,0,4,0" IsDefault="True"/>
            <Button Content="Restore Defaults" Command="{Binding RestoreDefaultsCommand}" Width="110" Margin="0,0,4,0"/>
            <Button Content="Cancel" Width="80" IsCancel="True"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Display">
                <StackPanel Margin="8">
                    <CheckBox Content="Linear Interpolation" IsChecked="{Binding LinearInterpolation}" Margin="0,4"/>
                    <CheckBox Content="Show Baselines" IsChecked="{Binding ShowBaselines}" Margin="0,4"/>
                    <CheckBox Content="Show Grid" IsChecked="{Binding ShowGrid}" Margin="0,4"/>
                    <CheckBox Content="Anti-Aliasing" IsChecked="{Binding AntiAliasing}" Margin="0,4"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBlock Text="Default Page Time (sec):" VerticalAlignment="Center" Width="160"/>
                        <TextBox Text="{Binding DefaultPageTime}" Width="80"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Annotations">
                <StackPanel Margin="8">
                    <CheckBox Content="Show Annotation Markers" IsChecked="{Binding ShowAnnotationMarkers}" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBlock Text="Annotation Font Size:" VerticalAlignment="Center" Width="160"/>
                        <TextBox Text="{Binding AnnotationFontSize}" Width="80"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Print">
                <StackPanel Margin="8">
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock Text="Print DPI:" VerticalAlignment="Center" Width="160"/>
                        <TextBox Text="{Binding PrintDpi}" Width="80"/>
                    </StackPanel>
                    <CheckBox Content="Print Grayscale" IsChecked="{Binding PrintGrayscale}" Margin="0,4"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Remote Control">
                <StackPanel Margin="8">
                    <CheckBox Content="Enable Remote Control" IsChecked="{Binding RemoteControlEnabled}" Margin="0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                        <TextBlock Text="TCP Port:" VerticalAlignment="Center" Width="160"/>
                        <TextBox Text="{Binding RemoteControlPort}" Width="80"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
